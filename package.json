{
  "name": "assistente-virtual-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente de IA integrado ao WhatsApp com RAG, agendamentos e dashboard",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "dashboard:dev": "cd src/dashboard && npm run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "seed": "tsx infra/seeds/seed.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "prisma": "^5.0.0",
    "tsx": "^4.22.4"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0"
  }
}
