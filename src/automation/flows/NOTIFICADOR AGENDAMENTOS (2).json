    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  nq.id AS queue_id,\n  nq.appointment_id,\n  nq.client_id,\n  nq.type AS notification_type,\n  nq.send_at,\n  nq.expires_at,\n  nq.attempts,\n  a.scheduled_at,\n  a.ends_at,\n  a.status AS appointment_status,\n  s.name AS service_name,\n  p.name AS professional_name,\n  c.phone AS client_phone,\n  c.name AS client_name,\n  b.id AS business_id,\n  b.agent_name,\n  b.timezone,\n  b.phone_number AS business_phone,\n  b.name AS business_name\nFROM notification_queue nq\nJOIN appointments a ON nq.appointment_id = a.id\nJOIN services s ON a.service_id = s.id\nJOIN professionals p ON a.professional_id = p.id\nJOIN clients c ON nq.client_id = c.id\nJOIN business b ON a.business_id = b.id\nWHERE nq.status = 'pending'\n  AND nq.send_at <= now()\n  AND nq.attempts < 3\n  AND c.ia_status <> 'blocked'\n  AND b.active = true\n  AND (nq.expires_at IS NULL OR nq.expires_at > now())\n  AND (\n    -- cancellation_notice passa mesmo com appointment cancelado\n    nq.type = 'cancellation_notice'\n    OR\n    -- outras notificacoes so disparam com appointment ativo\n    (nq.type IN ('reminder_d1','reminder_h2','booking_created','booking_confirmed','confirmation_request')\n     AND a.status IN ('pending','confirmed'))\n  )\n  AND (\n    -- Pula reminder_d1 se o appointment ja esta dentro de 23h\n    -- (cliente marcou com pouca antecedencia, nao faz sentido lembrar 'amanha')\n    nq.type != 'reminder_d1'\n    OR a.scheduled_at >= now() + INTERVAL '23 hours'\n  )\nORDER BY\n  CASE nq.type\n    WHEN 'cancellation_notice' THEN 1\n    WHEN 'booking_created'     THEN 2\n    WHEN 'reminder_h2'         THEN 3\n    ELSE 4\n  END,\n  nq.send_at ASC\nLIMIT 20;",
        "options": {}
      },
